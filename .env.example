# Server-only. Copy to `.env.local` (Next.js) and `.env` (Prisma CLI).
# Never commit real secrets. `.env*` is gitignored except this file.

# --- Required (all environments) ---
# postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=

# Public site origin (payment callbacks, emails, absolute fetches)
# Local: http://localhost:3000
# Production on Render: https://lucien-perrin.onrender.com
# Never leave these as localhost on the live server — phones cannot open that link.
API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Signed session cookie secret (min 32 chars in production)
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# --- Optional admin bootstrap ---
# Used by `npm run create-admin` only (never by production seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Lucien Perrin Admin

# --- Payments (FAZ 12.11) ---
# PAYMENT_PROVIDER=test | iyzico
PAYMENT_PROVIDER=test
PAYMENT_CURRENCY=TRY

# Required in hosted production. Local `next start` may fall back to AUTH_SECRET.
PAYMENT_WEBHOOK_SECRET=

# Live iyzico keys — never use sandbox credentials in production
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
# Sandbox: https://sandbox-api.iyzipay.com
# --- Email verification ---
# Public from-address shown in the inbox
MAIL_FROM=Lucien Perrin <no-reply@your-domain.com>

# Option A: Resend
# RESEND_API_KEY=

# Option B: SMTP (Gmail, Yandex, custom domain, etc.)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=

