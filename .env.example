# Server-only. Copy to .env.local for local development.
# Do not commit .env.local.

# FAZ 12.2 — PostgreSQL connection string
# postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public
DATABASE_URL=

# Public origin used by future server-side API calls
API_BASE_URL=http://localhost:3000

# FAZ 12.6 — signed session cookie (required)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Optional. Used by `npm run create-admin` and `npm run seed`.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=VELORA Admin
