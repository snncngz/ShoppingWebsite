# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# Personal notes with live secrets — never push
/docs/SAHIP-GIZLI.md

# logs
*.log
logs/

# uploaded product images (runtime storage; served via /api/uploads)
/storage/uploads/**
!/storage/uploads/.gitkeep
!/storage/uploads/products/.gitkeep
/public/uploads/products/*
!/public/uploads/products/.gitkeep

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
